# ==============================================================================
# Employee Leave Management System - Environment Variables Template
# ==============================================================================
# Copy this file to .env or set environment variables in your deployment environment.
# DO NOT COMMIT REAL PRODUCTION CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# Database Connection (MySQL)
DB_URL=jdbc:mysql://localhost:3306/employee_leave_db?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=

# Security & Authentication
# If left empty, the application generates a secure ephemeral 256-bit key at startup.
# For persistent sessions across restarts, provide a 256-bit base64 secret.
JWT_SECRET=

# Frontend Configuration
VITE_API_URL=http://localhost:8080/api
